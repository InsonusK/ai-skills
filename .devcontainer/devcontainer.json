// For format details, see https://aka.ms/devcontainer.json.
// One container for writing skills and the VP libraries they point to: Go, .NET, Python, Angular,
// plus Docker for the libraries' conformance runs against real PostgreSQL / Redis.
{
	"name": "ai-skills",
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Stacks the skills' runnable examples are verified with (make test-and-report in each example).
		"ghcr.io/devcontainers/features/python:1": { "version": "3.13" },
		"ghcr.io/devcontainers/features/go:1": { "version": "1.26" },
		"ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
		"ghcr.io/devcontainers/features/node:1": { "version": "lts" }
	},

	// Angular CLI globally; psql / redis-cli to inspect the databases the conformance runs use.
	"postCreateCommand": "bash .devcontainer/post_command.sh",

	// PostgreSQL / Redis for local conformance runs are started with Docker, e.g.
	//   docker run -d --name pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:18
	//   docker run -d --name redis -p 6379:6379 redis:8
	//"forwardPorts": [5432, 6379],
}
