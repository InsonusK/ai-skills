{
  "testRunner": "command",
  "commandRunner": {
    "command": "npx cucumber-js --format progress"
  },
  "mutate": [
    "src/linkcheck/**/*.ts",
    "!src/linkcheck/**/test/**/*.ts"
  ],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "ignorePatterns": [
    "src/app/**",
    "tools/livingdoc/node_modules/**"
  ]
}
