{
  "name": "platform-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/platform-shell/src",
  "tags": [
    "type:app",
    "scope:platform"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/platform-shell",
        "browser": "apps/platform-shell/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/platform-shell/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/platform-shell/public"
          }
        ],
        "styles": [
          "apps/platform-shell/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "platform-shell:build:production"
        },
        "development": {
          "buildTarget": "platform-shell:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {}
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "platform-shell:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "platform-shell:build",
        "port": 4200,
        "staticFilePath": "dist/apps/platform-shell/browser",
        "spa": true
      }
    }
  }
}