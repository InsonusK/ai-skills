graph TD
    subgraph Common["Common features (Mandatory baseline)"]
        direction TB
        subgraph Row1[" "]
            direction LR
            PLAT["Platform<br/>(root of the family)"]
            MONO["(host composes a monolith<br/>via parent_plateaus)"]
        end
        subgraph Row2[" "]
            direction LR
            RRF["RuntimeRemoteFederation"]
            PC["PlatformContracts"]
            FRC["FederationRemoteContract"]
        end
    end
    style Row1 fill:none,stroke:none
    style Row2 fill:none,stroke:none
    style MONO fill:none,stroke-dasharray: 3 3

    subgraph Host["Host-side variability (the platform-shell repo)"]
        direction LR
        HDSC["HostDesignSystemConsumption"]
        SS["SessionSharing"]
        FRR["FederatedReadResilience"]
    end
    subgraph Remote["Remote-side variability (each embeddable-app repo, per remote)"]
        direction LR
        RSC["RemoteSessionConsumption"]
        RDSC["RemoteDesignSystemConsumption"]
        RIA["RemoteInternalArchitecture<br/>(aspirational)"]
    end

    Common -->|Optional| Host
    Common -->|"Optional (zero or more remotes)"| Remote

    SS -. "Requires monolith:Authentication" .-> EXT1["(monolith catalog)"]
    FRR -. "Requires monolith:OfflineReadResilience" .-> EXT1
    RSC -. "meaningful only if" .-> SS
    style EXT1 fill:none,stroke-dasharray: 3 3
