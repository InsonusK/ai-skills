formulas:
  plateas: file.backlinks.map(value.asFile()).filter(value.hasTag("skill/template/plateau")).map(value.asLink())
views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("skill/architecture/solution")
    order:
      - file.name
      - built_on_plateau
      - formula.plateas
    sort:
      - property: formula.Untitled
        direction: ASC
