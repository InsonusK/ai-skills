formulas:
  plateas: file.backlinks.map(value.asFile()).filter(value.hasTag("skill/template/plateau")).map(link(value.path, value.properties.name))
views:
  - type: table
    name: Table
    filters:
      and:
        - file.tags.contains("skill/architecture/solution")
        - file.folder.startsWith("skills/dotnet/architecture/v3/solutions")
    order:
      - file.name
      - built_on_plateau
      - formula.plateas
    sort:
      - property: formula.Untitled
        direction: ASC
