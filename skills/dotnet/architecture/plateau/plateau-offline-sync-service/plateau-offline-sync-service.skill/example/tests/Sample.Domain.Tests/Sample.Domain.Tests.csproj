<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Reqnroll.xUnit" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared spec's format/ folder, re-proven fail-fast through the VO constructors. Linked, never copied.
         ReqnrollFeatureFiles, not None: Reqnroll generates tests only for its own feature items. -->
    <ReqnrollFeatureFiles Include="..\..\src\Modules\Sample\Sample.Domain.Rules.Spec\format\**\*.feature" Link="Rules\Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Sample\Sample.Domain\Sample.Domain.csproj" />
  </ItemGroup>
</Project>
