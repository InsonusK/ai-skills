# Environment file for {service-name} — Docker Compose / Docker Stack.
# Safe to commit: every value here is either non-secret or a placeholder.
# The Docker CLI reads this file to interpolate ${VAR} placeholders in the
# compose/stack file; it is not injected into the container directly.

# --- Non-secret configuration ---
ASPNETCORE_ENVIRONMENT=Production
SERVICE_PORT=8080
LOG_LEVEL=Information

# --- SECRET: never put real values in this file. ---
# Each secret is created out-of-band (Docker secret / Kubernetes Secret /
# secret manager) and consumed through the {NAME}_FILE convention — see
# docker-entrypoint.sh.example and the "_FILE environment variables" rule.
# Uncomment and point at the mounted secret file when running via
# docker stack (see docker-stack.example.yml); leave unset for plain
# docker compose, where env_file/.env may carry a local dev-only value.
# CONNECTION_STRING_FILE=/run/secrets/connection_string
