classDiagram
    direction LR
    namespace command {
        class PlanRemoteItemsHandler {
            +handle(command)
        }
        class RemotePlanner_protocol["RemotePlanner"] {
            <<Protocol>>
            plan(titles)
        }
    }
    namespace service {
        class RemotePlanner {
            +plan(titles)
        }
        class TodoApi_protocol["TodoApi"] {
            <<Protocol>>
            plan_items(titles)
        }
        class TodoServiceUnavailableError {
        }
        class TitlesRejectedError {
        }
    }
    namespace todo_api {
        class TodoApi {
            +plan_items(titles)
            +aclose()
        }
        class Item {
            <<dataclass>>
            +title, done
        }
        class _ItemsService {
            <<mock>>
            +PlanItems(request, context)
        }
    }
    namespace gen {
        class ItemsServiceStub {
            <<generated>>
        }
        class ItemsServiceServicer {
            <<generated>>
        }
    }
    namespace core_grpcclient {
        class GrpcClient {
            +channel
            +open(...)$
            +aclose()
        }
        class _CallInterceptor {
            +intercept_unary_unary(...)
            -_attempt(...)
        }
        class GrpcConfig {
            <<dataclass>>
            +name, host, port, tls, timeout
            +target
        }
        class Method {
            <<dataclass>>
            +name, retryable
        }
    }
    namespace core_outcomes {
        class ApiUnavailableError {
            +api
        }
        class ApiStatusError {
            +code, message, http_status
        }
        class StatusCode {
            <<IntEnum>>
            google.rpc.Code
        }
    }
    namespace core_pipeline {
        class Call {
            <<dataclass>>
            +api, operation, retryable
        }
        class Middleware {
            <<Protocol>>
            __call__(call, call_next)
        }
    }

    PlanRemoteItemsHandler --> RemotePlanner_protocol : uses
    RemotePlanner ..|> RemotePlanner_protocol
    RemotePlanner --> TodoApi_protocol : uses
    TodoApi ..|> TodoApi_protocol
    RemotePlanner ..> ApiUnavailableError : catches
    RemotePlanner ..> ApiStatusError : catches
    RemotePlanner ..> TodoServiceUnavailableError : raises
    RemotePlanner ..> TitlesRejectedError : raises
    ApiStatusError --> StatusCode
    TodoApi --> Item : maps to
    TodoApi --> ItemsServiceStub : one call per method
    TodoApi --> GrpcClient : owns
    ItemsServiceStub --> GrpcClient : over channel
    GrpcClient --> _CallInterceptor
    GrpcClient --> GrpcConfig
    GrpcClient ..> _ItemsService : mock
    _ItemsService --|> ItemsServiceServicer
    _CallInterceptor --> Method : the listed ones
    _CallInterceptor --> Middleware : runs around each attempt
    _CallInterceptor ..> Call
