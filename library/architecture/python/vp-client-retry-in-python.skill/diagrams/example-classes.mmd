classDiagram
    direction LR
    namespace middleware_retry {
        class RetryMiddleware {
            +__call__(call, call_next)
        }
        class RetryConfig {
            <<dataclass>>
            +attempts, backoff
        }
    }
    namespace core_pipeline {
        class Call {
            <<dataclass>>
            +api, operation, retryable
        }
        class Middleware {
            <<Protocol>>
            __call__(call, call_next)
        }
    }
    namespace core_outcomes {
        class ApiUnavailableError {
            +api
        }
    }
    namespace core_httpclient {
        class HttpClient {
            +call(method, path, request, decode)
        }
        class Operation {
            <<dataclass>>
            +method, path, retryable
        }
    }
    namespace todo_api {
        class OPERATIONS {
            <<list>>
            retryable=True on POST /v1/items/plan
        }
    }

    RetryMiddleware ..|> Middleware
    RetryMiddleware --> RetryConfig
    RetryMiddleware ..> Call : reads retryable
    RetryMiddleware ..> ApiUnavailableError : repeats on
    HttpClient --> Middleware : runs around each attempt
    HttpClient --> Operation : the listed ones
    OPERATIONS --> Operation
