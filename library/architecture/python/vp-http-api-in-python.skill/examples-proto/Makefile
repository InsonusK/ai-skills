SHELL := /bin/bash
VENV := .venv
PYTHON := $(VENV)/bin/python

.PHONY: init run proto-gen test lint

# Run once after cloning: a virtual environment with the package and its dev tools.
# The environment holds no symbolic link (--copies, and lib64 -> lib removed,
# which nothing reads), so the skill sync of the catalog can walk the example.
init:
	python3 -m venv --copies $(VENV)
	rm -f $(VENV)/lib64
	$(PYTHON) -m pip install --quiet -e '.[dev]'

# Serves the gRPC API on :9090 (reflection on) and its HTTP form on :8080
# (Swagger UI at http://localhost:8080/swagger/), until Ctrl+C.
run:
	GRPC_REFLECTION_ENABLED=true HTTP_API_DOCS_ENABLED=true $(PYTHON) -m todo

# The OpenAPI spec of the HTTP form is generated by grpc-gateway's
# protoc-gen-openapiv2 - the same generator, version, and options as the Go
# and dotnet catalogs, so every stack publishes the same spec for one proto
# file. It is a Go binary with no pip package: downloaded once for the
# platform into tools/bin/. It wants a Go import path for each file
# (M{file}=example.com/{contract}); the path does not change the spec.
OPENAPIV2_VERSION := v2.31.0
OS := $(shell uname -s | tr A-Z a-z)
ARCH := $(shell uname -m | sed -e 's/aarch64/arm64/' -e 's/amd64/x86_64/')
OPENAPIV2 := tools/bin/protoc-gen-openapiv2-$(OPENAPIV2_VERSION)

$(OPENAPIV2):
	mkdir -p tools/bin
	curl -sSfL -o $@ https://github.com/grpc-ecosystem/grpc-gateway/releases/download/$(OPENAPIV2_VERSION)/protoc-gen-openapiv2-$(OPENAPIV2_VERSION)-$(OS)-$(ARCH)
	chmod +x $@

# Regenerates, from the proto files under docs/integration/api/ and the
# annotations they import (third_party/proto/, vendored):
# - src/todo/gen/api/{contract}/: the messages (_pb2), the services
#   (_pb2_grpc), and their type stubs (.pyi). Each proto file is mapped to the
#   import path of its generated package, so the generated modules import each
#   other as todo.gen.api.{contract};
# - src/protoc_gen_openapiv2/: the openapiv2 annotations, which the generated
#   messages import at run time (google.api comes from googleapis-common-protos);
# - {file}.swagger.json beside each proto file: the spec of the HTTP form.
# The Python generators are pinned dev dependencies; commit what this writes.
proto-gen: $(OPENAPIV2)
	mkdir -p src/protoc_gen_openapiv2/options
	touch src/protoc_gen_openapiv2/__init__.py src/protoc_gen_openapiv2/options/__init__.py
	$(PYTHON) -m grpc_tools.protoc -Ithird_party/proto \
		--plugin=protoc-gen-mypy=$(VENV)/bin/protoc-gen-mypy \
		--python_out=src --mypy_out=src \
		third_party/proto/protoc-gen-openapiv2/options/*.proto
	for dir in docs/integration/api/*/; do \
		contract=$$(basename $$dir); \
		mkdir -p src/todo/gen/api/$$contract; \
		touch src/todo/gen/__init__.py src/todo/gen/api/__init__.py src/todo/gen/api/$$contract/__init__.py; \
		$(PYTHON) -m grpc_tools.protoc \
			-Itodo/gen/api/$$contract=$$dir -Ithird_party/proto \
			--plugin=protoc-gen-mypy=$(VENV)/bin/protoc-gen-mypy \
			--plugin=protoc-gen-mypy_grpc=$(VENV)/bin/protoc-gen-mypy_grpc \
			--python_out=src --grpc_python_out=src \
			--mypy_out=src --mypy_grpc_out=src \
			$$dir*.proto; \
		for file in $$(cd docs/integration/api && ls $$contract/*.proto); do \
			$(PYTHON) -m grpc_tools.protoc \
				-Idocs/integration/api -Ithird_party/proto \
				--plugin=protoc-gen-openapiv2=$(OPENAPIV2) \
				--openapiv2_out=docs/integration/api \
				--openapiv2_opt=disable_default_responses=true,enable_rpc_deprecation=true,M$$file=example.com/$$contract \
				$$file; \
		done; \
	done

# Every Cucumber scenario of every package (pytest-bdd runs inside pytest).
# A real project adds its testing contract (kinds, reports, mutation) per
# solution-conformance-testing-in-python; this example leaves it out.
test:
	$(PYTHON) -m pytest -q -m "not status/todo and not status/broken"

lint:
	$(PYTHON) -m mypy
