# The base example this variation point attaches to, relative to the repository root.
base library/architecture/go/base-plateau-in-go.skill/examples
# Base files the variation point changes - nothing else of the base may differ.
change cmd/todo/main.go
change go.mod
change go.sum
change Makefile
change README.md
# Base files the variation point removes: the startup entry it replaces.
delete internal/api/startup/*
