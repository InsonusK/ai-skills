sequenceDiagram
    autonumber
    participant Main as run<br/>cmd/todo/main.go
    participant Runner as entry.RunAll<br/>internal/api/core/entry/entry.go
    participant Startup as startup.Run<br/>internal/api/startup/startup.go
    participant Log as logging.Middleware<br/>internal/command/middleware/logging/logging.go
    participant Handler as PlanItemsHandler<br/>internal/command/plan_items.go
    participant Planner as service.Planner<br/>internal/domain/service/planner.go

    Main->>+Runner: every Entry, until the first ends
    Runner->>+Startup: the startup entry
    Note over Startup: reads STARTUP_TITLES into PlanItems
    Startup->>+Log: PlanItems, through the command middleware
    Note over Log: record "command called"
    Log->>+Handler: PlanItems
    Handler->>+Planner: the titles
    Planner-->>-Handler: open items, or an error with its kind
    Handler-->>-Log: the result, or the error
    Note over Log: record "command handled" or "command failed"
    Log-->>-Startup: the result, or the error
    Note over Startup: writes the result as one JSON line
    Startup-->>-Runner: nil, or the error
    Runner-->>-Main: the exit code: 0, 2 for invalid, 1 for a failure
