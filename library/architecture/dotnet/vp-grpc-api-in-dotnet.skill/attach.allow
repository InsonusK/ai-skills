# The gRPC API variation point attaches to the base plateau: it adds its folders and
# the contract, and changes only these base files.
base library/architecture/dotnet/base-plateau-in-dotnet.skill/examples
change src/App/App.Host/Program.cs
change src/App/App.Host/App.Host.csproj
change src/App/App.Host.Tests/App.Host.Tests.csproj
change Directory.Packages.props
change Makefile
change README.md
# The startup entry it replaces, with its scenarios.
delete src/App/App.Host/Api/Startup/*
delete src/App/App.Host.Tests/features/Startup.feature
delete src/App/App.Host.Tests/Steps/StartupSteps.cs
