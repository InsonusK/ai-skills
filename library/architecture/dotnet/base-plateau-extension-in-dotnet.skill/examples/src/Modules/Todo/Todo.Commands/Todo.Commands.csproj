<Project Sdk="Microsoft.NET.Sdk">
  <!-- What an entry point sees of the module: the commands and their results.
       Only MediatR.Contracts (IRequest), so an entry point referencing it
       reaches neither the handlers nor the domain. -->
  <ItemGroup>
    <PackageReference Include="MediatR.Contracts" />
  </ItemGroup>
  <ItemGroup>
    <!-- The marks a command carries (Shared/Access). -->
    <ProjectReference Include="..\..\..\Shared\Shared.csproj" />
  </ItemGroup>
</Project>
