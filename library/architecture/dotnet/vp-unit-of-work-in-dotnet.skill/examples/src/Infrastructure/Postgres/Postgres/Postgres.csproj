<Project Sdk="Microsoft.NET.Sdk">
  <!-- The application's PostgreSQL: the one AppDbContext, the mapping of every
       module's entities, the repository, the translation of failures, and the
       migrations. It sees the modules' domains, which it maps; only the
       composition roots (App.Host, App.Migrate) reference it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Shared.csproj" />
    <ProjectReference Include="..\..\..\Modules\Todo\Todo.Domain\Todo.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" />
    <!-- dotnet ef generates the migrations with it; nothing of it is deployed. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
</Project>
