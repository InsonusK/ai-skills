classDiagram
    direction LR
    namespace Retry {
        class RetryMiddleware {
            +RunAsync(call, next, token)
        }
        class RetryConfig {
            <<record>>
            +Attempts, Backoff
            +Load(prefix)$
        }
    }
    namespace Client_Pipeline {
        class ClientCall {
            <<record>>
            +Api, Operation, Retryable
        }
        class IClientMiddleware {
            <<interface>>
            RunAsync(call, next, token)
        }
    }
    namespace Client_Abstractions {
        class ApiUnavailableException {
            +Api string
        }
    }
    namespace Client_Http {
        class HttpApiClient {
            +CallAsync(method, path, request, token)
        }
        class HttpOperation {
            <<record>>
            +Method, Path, Retryable
        }
    }
    namespace TodoApi {
        class TodoApiClient {
            +Operations$
        }
    }

    RetryMiddleware ..|> IClientMiddleware
    RetryMiddleware --> RetryConfig
    RetryMiddleware ..> ClientCall : reads Retryable
    RetryMiddleware ..> ApiUnavailableException : repeats on
    HttpApiClient --> IClientMiddleware : runs around each attempt
    HttpApiClient --> HttpOperation : the listed ones
    TodoApiClient --> HttpOperation : marks Retryable
