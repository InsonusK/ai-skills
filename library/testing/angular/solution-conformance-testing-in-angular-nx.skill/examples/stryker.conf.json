{
  "testRunner": "command",
  "commandRunner": {
    "command": "npx cucumber-js --format progress"
  },
  "mutate": [
    "libs/linkcheck/src/linkcheck/**/*.ts",
    "libs/formatter/src/**/*.ts",
    "apps/portal/src/logic/**/*.ts",
    "!**/test/**/*.ts",
    "!**/spec/**/*.ts"
  ],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "ignorePatterns": [
    "tools/livingdoc/node_modules/**"
  ]
}
