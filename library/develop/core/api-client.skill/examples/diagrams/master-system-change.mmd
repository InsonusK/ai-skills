flowchart LR
  subgraph before["Before: the User API owns the name"]
    C1[command] -->|UserName| S1[UserService]
    S1 --> CL1[UserApiClient]
    CL1 -->|GET /getUserName| A1[(User API)]
  end
  subgraph after["After: the Directory API owns the name - a project redesign"]
    C2["command or domain service<br/>joins the two answers"] -->|Surname, NameId| S2[UserService]
    C2 -->|Name by id| S3[DirectoryService]
    S2 --> CL2[UserApiClient]
    S3 --> CL3[DirectoryApiClient]
    CL2 -->|GET /getUserName| A2[(User API)]
    CL3 -->|GET /names/id| A3[(Directory API)]
  end
  before ==>|"the master system of the name changed:<br/>outside api-client"| after
